# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# secrets
client_secret.json
tokens.json

# large media
public/backgrounds/*
!public/backgrounds/.gitkeep
test-audio.mp3
public/generated/*
public/output/*
public/temp/*

# binaries
ffmpeg/

# temp scripts
test-*.js
inspect-*.js

# respaldos locales
.backup-fase1/
public/custom-videos/*

# configuración local con tokens de redes y registro de publicaciones
/data/
# caché de medios generados/descargados (pesado y con material de terceros)
public/ai-vault/*
# binarios descargados
/bin/

# caché local de la CLI de Supabase
supabase/.temp/
_to_delete/

# Registro local del servidor
logs/
