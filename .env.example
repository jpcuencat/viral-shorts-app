# --- Obligatorias ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GEMINI_API_KEY=

# --- Opcionales ---
# Modelo de Gemini (por defecto gemini-3-flash-preview)
GEMINI_MODEL=
# Token de Hugging Face para SD3 (si falta se usa Pollinations Flux)
HF_TOKEN=
# OBLIGATORIA desde la Fase 2: clave secreta del proyecto (Supabase → Project Settings → API Keys → secret).
# La usa el worker de trabajos en segundo plano, el índice del vault y la limpieza de medios.
# Es solo de servidor: nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Worker de trabajos (corre dentro de `npm run dev` / `npm start`)
# EMBEDDED_WORKER=false   # para desactivarlo
WORKER_POLL_MS=3000

# Correo de la cuenta a la que se asignan las publicaciones y el webhook importados de los JSON locales
LOCAL_DATA_OWNER_EMAIL=

# Binarios (si se dejan vacíos: carpeta del proyecto → PATH del sistema)
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
SUBTITLE_FONT_FILE=

# Audio
MUSIC_VOLUME=0.12
TARGET_LUFS=-14

# Subida de videos propios
UPLOAD_MAX_MB=500

# Tendencias: países de Google Trends a consultar (códigos ISO). Ecuador es uno más.
TRENDS_MARKETS=US,GB,IN,BR,MX,ES,AR,CO,EC,PE,CL,DE,FR,JP

# Túnel de Cloudflare (npm run tunnel). Sin token se usa un túnel rápido de trycloudflare.com.
# Con token (túnel con nombre) la URL es fija: pon también PUBLIC_APP_URL (ej. https://app.tudominio.com).
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_APP_URL=
